; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alchemy Workshop 炼金工坊"
config/description="文字冒险炼金游戏：剧情探索、随机异象与魔法阵炼成，直至贤者之石。"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Store="*res://scripts/singletons/save_store.gd"
Sfx="*res://scripts/singletons/sfx_manager.gd"
AiClient="*res://scripts/singletons/ai_client.gd"
Game="*res://scripts/singletons/game_manager.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_size=Vector2i(1152, 720)

[gdscript]

warnings/inference_on_variant=0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
